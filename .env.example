# Copy to .env locally; never commit populated credentials.
DATABASE_URL=sqlite+aiosqlite:///./runtime-data/app.sqlite3
APP_TIMEZONE=UTC
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
ALLOWED_TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
# Optional USDA lookup; empty key keeps local/manual food paths available.
USDA_API_KEY=
USDA_TIMEOUT_SECONDS=10
# AI is not yet implemented. No paid AI calls are made.
LLM_PROVIDER=disabled
LLM_MONTHLY_BUDGET_USD=10
RAW_INPUT_RETENTION_DAYS=30
DRAFT_INACTIVITY_TTL_DAYS=7
