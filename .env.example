# Copy to .env locally; never commit populated credentials.
DATABASE_URL=sqlite+aiosqlite:///./runtime-data/app.sqlite3
APP_TIMEZONE=UTC
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
ALLOWED_TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
# Optional USDA lookup; empty key keeps local/manual food paths available.
USDA_API_KEY=
USDA_TIMEOUT_SECONDS=10
# Optional AI drafts: disabled until app-owned credentials and policy/evaluation pass.
LLM_PROVIDER=disabled
# OPENROUTER_API_KEY=
# AI_ENDPOINT_MANIFEST=/data/config/openrouter-endpoints.json
# CHATGPT_CREDENTIALS_PATH=/auth/chatgpt-credentials.json
# CHATGPT_POLICY_PATH=/auth/chatgpt-policy.json
# Mini App API stays disabled until HTTPS ingress is configured.
MINIAPP_ENABLED=false
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
# MINIAPP_URL=https://diary.example.org
LLM_MONTHLY_BUDGET_USD=10
RAW_INPUT_RETENTION_DAYS=30
DRAFT_INACTIVITY_TTL_DAYS=7
